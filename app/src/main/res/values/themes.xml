<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MotoMesh" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorSurface">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <!-- Icon button style — compact, fits beside Connect -->
    <style name="Widget.MotoMesh.IconButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/lo_text</item>
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">#1C2333</item>
        <item name="iconTint">@color/lo_text</item>
        <item name="iconSize">22dp</item>
    </style>

    <!-- Connect button style — larger, accent-background, bold text -->
    <style name="Widget.MotoMesh.ConnectButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">#1A3A2E</item>
        <item name="iconTint">#B5FFDA</item>
        <item name="iconSize">24dp</item>
    </style>
</resources>
