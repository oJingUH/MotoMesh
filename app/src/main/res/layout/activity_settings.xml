<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- ── Profile ────────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#161B22">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_profile_title"
                    android:textSize="18sp"
                    android:textColor="@color/lo_text"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_username_hint"
                    android:textColorHint="@color/lo_text"
                    app:boxBackgroundColor="#0D1117"
                    app:boxStrokeColor="@color/lo_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textColorHint="@color/lo_text" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvUsernameStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/lo_red"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── Network ────────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#161B22">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_network_title"
                    android:textSize="18sp"
                    android:textColor="@color/lo_text"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRelayHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_relay_host_hint"
                    android:textColorHint="@color/lo_text"
                    app:boxBackgroundColor="#0D1117"
                    app:boxStrokeColor="@color/lo_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRelayHost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textColorHint="@color/lo_text" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRelayPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/settings_relay_port_hint"
                    android:textColorHint="@color/lo_text"
                    app:boxBackgroundColor="#0D1117"
                    app:boxStrokeColor="@color/lo_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRelayPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textColorHint="@color/lo_text" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Channel / Network ID -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilChannel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/settings_channel_hint"
                    android:textColorHint="@color/lo_text"
                    app:boxBackgroundColor="#0D1117"
                    app:boxStrokeColor="@color/lo_blue"
                    app:helperText="@string/settings_channel_helper"
                    app:helperTextEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etChannel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1"
                        android:maxLength="2"
                        android:textColor="@color/white"
                        android:textColorHint="@color/lo_text" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvRelayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/lo_red"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── Audio ──────────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#161B22">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_audio_title"
                    android:textSize="18sp"
                    android:textColor="@color/lo_text"
                    android:layout_marginBottom="12dp" />

                <!-- VOX threshold slider -->
                <TextView
                    android:id="@+id/tvVoxThresholdLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_vox_threshold"
                    android:textSize="14sp"
                    android:textColor="@color/lo_text"
                    android:layout_marginBottom="4dp" />

                <SeekBar
                    android:id="@+id/sbVoxThreshold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="7200"
                    android:progress="1200"
                    android:progressTint="@color/accent_blue"
                    android:thumbTint="@color/accent_blue" />

                <TextView
                    android:id="@+id/tvVoxThresholdValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/lo_text"
                    android:textSize="11sp" />

                <!-- Duck depth slider -->
                <TextView
                    android:id="@+id/tvDuckDepthLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_duck_depth"
                    android:textSize="14sp"
                    android:textColor="@color/lo_text"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp" />

                <SeekBar
                    android:id="@+id/sbDuckDepth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="90"
                    android:progress="80"
                    android:progressTint="@color/accent_blue"
                    android:thumbTint="@color/accent_blue" />

                <TextView
                    android:id="@+id/tvDuckDepthValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/lo_text"
                    android:textSize="11sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── Save ───────────────────────────────────────────────────── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_save_settings"
            android:textSize="16sp"
            app:cornerRadius="8dp"
            android:layout_marginHorizontal="8dp" />

        <!-- ── About ─────────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvAbout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/lo_text"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>