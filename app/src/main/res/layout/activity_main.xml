<?xml version="1.0" encoding="utf-8"?>
<!--
  Optimized for rider ergonomics (MotoMesh QoL pass 2):
  - Single status bar row: Connection state + transport mode + RSSI + node count (condensed)
  - Controls row: large thickness hit-target buttons, Connect centered (thumb-reachable),
    Mute left, Settings right
  - Top bar: app name + music ducked bar header
  - guideline_bottom at 86% — freezes status + controls in the bottom 14% (214 px on 1080p)
  - Active TX / VOX indicated via accent color in the status bar
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D1117"
        tools:context=".ui.MainActivity">

        <!-- ── Top bar: app name + music bar ─────────────────────────────── -->

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/lo_text"
            app:layout_constraintBottom_toTopOf="@id/musicBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/guideline_top" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/musicBar"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:backgroundTint="#0D1117"
            android:indeterminate="false"
            android:max="100"
            app:layout_constraintBottom_toTopOf="@id/guideline_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.06" />

        <!-- ── Rider list ─────────────────────────────────────────────────── -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/nodeList"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#0D1117"
            app:layout_constraintBottom_toTopOf="@id/guideline_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/musicBar"
            tools:listitem="@layout/item_node" />

        <!-- Empty state — shown when no riders are connected. Tap for help. -->
        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/empty_rider_list"
            android:textColor="@color/lo_text_dim"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@id/guideline_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/musicBar" />

        <!-- ── guideline_bar: top of the status + control area ────────────── -->

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.86" />

        <!-- ── Status bar (single lane, all status in one readable row) ────── -->
        <!-- Layout order left-to-right: [State/Dot] [Mode] [RSSI] [NodeCount] [VOXdot] -->
        <!-- Padding 4dp between elements keeps them distinctive at 12sp -->

        <LinearLayout
            android:id="@+id/statusRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/ctrlRow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guideline_bar">

            <!-- Dot: indicates connection / transport state -->
            <View
                android:id="@+id/vDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@color/lo_red"
                android:shape="oval" />

            <!-- State text: "Connected" / "Scanning…" / "Disconnected" etc. -->
            <TextView
                android:id="@+id/tvConnState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="@string/conn_disconnected"
                android:textColor="@color/lo_red"
                android:textSize="12sp" />

            <!-- Mode badge: "LOOPBACK" | "LORA" | "CELLULAR" — tappable to cycle -->
            <TextView
                android:id="@+id/tvConnMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:background="@drawable/badge_mode_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/conn_loopback"
                android:textColor="@color/lo_text"
                android:textSize="10sp" />

            <!-- RSSI: "-67 dBm" aligned right of status -->
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvRssi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_rssi"
                android:textColor="@color/lo_text"
                android:textSize="11sp"
                android:textStyle="italic" />

            <!-- Node count -->
            <TextView
                android:id="@+id/tvNodeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/hint_nodes"
                android:textColor="@color/lo_text"
                android:textSize="11sp" />

            <!-- VOX dot: lit green when the local rider is speaking -->
            <View
                android:id="@+id/vVox"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/dot_vox"
                android:shape="oval"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ── Controls row: Connect (+ Mute + Settings) ──────────────────── -->

        <LinearLayout
            android:id="@+id/ctrlRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusRow">

            <!-- Mute — left, icon-only for glove ergonomics -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMute"
                style="@style/Widget.MotoMesh.IconButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/lo_red"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_mic"
                app:iconGravity="textStart" />

            <!-- Connect — center, largest of the three -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                style="@style/Widget.MotoMesh.ConnectButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="2"
                android:text="@string/btn_connect"
                android:textColor="#B5FFDA"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_radio" />

            <!-- Settings — right, visible icon button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettingsIcon"
                style="@style/Widget.MotoMesh.IconButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text=""
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_settings_gear"
                app:iconGravity="textStart"
                app:iconSize="22dp"
                app:iconTint="@color/lo_text" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>