<?xml version="1.0" encoding="utf-8"?>
<!--
  Node row — rider compact ergonomics.
  88dp height, padding 12, 4-column weighted row (4+4+2+1 = 11 weight).
  [Icon+Name+Callsign/RSSI]   [voice bar overflow]   [RSSI]   [loss %]
  All text fields set programmatically by NodeAdapter.bind(); no DataBinding
  expressions to avoid aapt2 parse warnings on layout merge.
-->
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="5dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp"
            android:weightSum="11">

            <!-- COLUMN 1 — icon + name + callsign/RSSI  (weight 4) -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_rider"
                    android:tint="@color/rider_icon_dim"
                    android:contentDescription="@string/rider_icon_desc" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <!-- Rider N — 14sp bold primary label -->
                    <TextView
                        android:id="@+id/tvNodeId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                        android:textColor="@color/lo_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Callsign sub-label — cyan accent, hidden by default; adapter shows/hides -->
                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- RSSI — under callsign; dim grey -->
                    <TextView
                        android:id="@+id/tvRssi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                        android:textColor="@color/lo_text"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- COLUMN 2 — voice activity bar  (weight 4) -->
            <!-- Tint set programmatically by NodeAdapter: cyan if loss < 30 %, red otherwise. -->

            <ProgressBar
                android:id="@+id/pbVoice"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="4"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/pb_bg"
                android:visibility="gone" />

            <!-- COLUMN 3 — RSSI dBm  (weight 2, right-aligned, 10 sp) -->

            <TextView
                android:id="@+id/tvLabelRssi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="2"
                android:gravity="end"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:textColor="@color/lo_text"
                android:textSize="10sp"
                tools:text="-67 dBm" />

            <!-- COLUMN 4 — packet loss %  (weight 1, right-aligned, 11 sp) -->

            <TextView
                android:id="@+id/tvLabelLoss"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:gravity="end"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:textColor="@color/lo_text"
                android:textSize="11sp"
                tools:text="0%" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</layout>
